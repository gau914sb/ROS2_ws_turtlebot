\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Geometric decomposition of~$\dot  {p}_{i}$ at the look-ahead point~$\mathbf  {a}_i$ (heading $\theta _i=30^\circ $, example). The \textcolor {green!60!black}{green} component (parallel to heading) drives forward speed~$v_i$. The \textcolor {orange!80!black}{orange} component (perpendicular to heading), divided by~$l$, drives angular speed~$\omega _i$.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:geom}{{3}{5}{Geometric decomposition of~$\dpdt {i}$ at the look-ahead point~$\mathbf {a}_i$ (heading $\theta _i=30^\circ $, example). The \textcolor {green!60!black}{green} component (parallel to heading) drives forward speed~$v_i$. The \textcolor {orange!80!black}{orange} component (perpendicular to heading), divided by~$l$, drives angular speed~$\omega _i$}{figure.caption.5}{}}
\newlabel{fig:geom@cref}{{[figure][3][]3}{[1][3][]5}}
