\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Signal flow for robot~$i$. The CBF law outputs a single-integrator velocity~$\dot  {p}_{i}$; the look-ahead transformation~$T(\theta _i)$ converts it to unicycle commands; saturation enforces actuator limits; the robot executes $(v_i,\omega _i)$. The heading~$\theta _i$ is fed back from the ArUco TF2 measurement.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:flow}{{2}{4}{Signal flow for robot~$i$. The CBF law outputs a single-integrator velocity~$\dpdt {i}$; the look-ahead transformation~$T(\theta _i)$ converts it to unicycle commands; saturation enforces actuator limits; the robot executes $(v_i,\omega _i)$. The heading~$\theta _i$ is fed back from the ArUco TF2 measurement}{figure.caption.3}{}}
\newlabel{fig:flow@cref}{{[figure][2][]2}{[1][3][]4}}
